# Safe placeholders only. Keep concrete Gate 11 values in the gitignored .azure/ environment.
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
AZURE_AI_ACCOUNT_NAME=<foundry-account-name>
AZURE_AI_PROJECT_NAME=<foundry-project-name>
AZURE_AI_PROJECT_ID=<foundry-project-resource-id>
AZURE_AI_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<foundry-project>
AZURE_EXISTING_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<foundry-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>
DATABASE_URL=postgresql+psycopg://strategy_redteam:strategy_redteam@localhost:5432/strategy_redteam
APP_ENV=development
LOG_LEVEL=INFO
DATASET_ROOT=tests/fixtures/offline-cache/manifests
CANONICAL_DATASET_ROOT=data/canonical/manifests
CONFIGURATION_ROOT=config
CORS_ORIGINS=http://localhost:3000
# Frontend public mode is the default. Set both only for an owner-controlled connected deployment.
NEXT_PUBLIC_PRODUCT_MODE=public
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
STRATEGY_REDTEAM_DATASET_CONTAINER_URL=https://<storage-account>.blob.core.windows.net/<dataset-container>
STRATEGY_REDTEAM_ARTIFACT_CONTAINER_URL=https://<storage-account>.blob.core.windows.net/<artifact-container>
